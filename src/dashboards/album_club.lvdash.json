{
  "datasets": [
    {
      "name": "people",
      "displayName": "People",
      "queryLines": [
        "SELECT person FROM (\n",
        "  SELECT 'Club' AS person, 0 AS sort\n",
        "  UNION ALL\n",
        "  SELECT person, 1 FROM dim_person WHERE role = 'member'\n",
        ")\n",
        "ORDER BY sort, person\n"
      ]
    },
    {
      "name": "my_stats",
      "displayName": "My stats",
      "queryLines": [
        "SELECT average_rating, albums_rated\n",
        "FROM agg_person_ratings\n",
        "WHERE person = :person\n"
      ],
      "parameters": [
        {
          "displayName": "person",
          "keyword": "person",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "Scott R"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "my_decades",
      "displayName": "My decades",
      "queryLines": [
        "SELECT concat(decade, 's') AS decade, average_rating, albums_rated\n",
        "FROM agg_person_decades\n",
        "WHERE person = :person\n",
        "ORDER BY decade\n"
      ],
      "parameters": [
        {
          "displayName": "person",
          "keyword": "person",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "Scott R"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "my_ratings",
      "displayName": "My ratings",
      "queryLines": [
        "SELECT r.rank, r.rating, a.label, a.artist, a.album, a.year, a.meeting_date, c.average_rating AS club_average\n",
        "FROM agg_album_rankings r\n",
        "JOIN dim_album a USING (listen_id)\n",
        "JOIN agg_album_ratings c USING (listen_id)\n",
        "WHERE r.person = :person\n",
        "ORDER BY r.rank, c.average_rating DESC\n"
      ],
      "parameters": [
        {
          "displayName": "person",
          "keyword": "person",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "Scott R"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "my_top_10",
      "displayName": "Top 10",
      "queryLines": [
        "SELECT r.rank, r.rating, a.label\n",
        "FROM agg_album_rankings r\n",
        "JOIN dim_album a USING (listen_id)\n",
        "WHERE r.person = :person AND r.rank <= 10\n"
      ],
      "parameters": [
        {
          "displayName": "person",
          "keyword": "person",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "Scott R"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "my_unrated",
      "displayName": "Not rated yet",
      "queryLines": [
        "SELECT a.label, a.artist, a.album, a.year, a.meeting_date, c.average_rating AS club_average\n",
        "FROM agg_unrated_albums u\n",
        "JOIN dim_album a USING (listen_id)\n",
        "LEFT JOIN agg_album_ratings c USING (listen_id)\n",
        "WHERE u.person = :person\n",
        "ORDER BY a.meeting_date DESC\n"
      ],
      "parameters": [
        {
          "displayName": "person",
          "keyword": "person",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "Scott R"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "albums",
      "displayName": "Albums",
      "queryLines": [
        "SELECT label FROM dim_album ORDER BY label\n"
      ]
    },
    {
      "name": "album",
      "displayName": "Album",
      "queryLines": [
        "SELECT r.rating, c.average_rating AS club_average, c.raters\n",
        "FROM dim_album a\n",
        "LEFT JOIN agg_album_rankings r ON r.listen_id = a.listen_id AND r.person = :person\n",
        "LEFT JOIN agg_album_ratings c ON c.listen_id = a.listen_id\n",
        "WHERE a.label = :album\n"
      ],
      "parameters": [
        {
          "displayName": "person",
          "keyword": "person",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "Scott R"
                }
              ]
            }
          }
        },
        {
          "displayName": "album",
          "keyword": "album",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": ""
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "album_tracks",
      "displayName": "Album tracks",
      "queryLines": [
        "SELECT t.position, t.title, coalesce(CAST(k.rank AS STRING), '') AS rank,\n",
        "  CASE WHEN k.liked THEN 'liked' ELSE 'not liked' END AS opinion\n",
        "FROM fact_track_picks k\n",
        "JOIN dim_track t USING (listen_id, position)\n",
        "JOIN dim_album a USING (listen_id)\n",
        "WHERE k.person = :person AND a.label = :album\n",
        "ORDER BY k.rank NULLS LAST, t.position\n"
      ],
      "parameters": [
        {
          "displayName": "person",
          "keyword": "person",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "Scott R"
                }
              ]
            }
          }
        },
        {
          "displayName": "album",
          "keyword": "album",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": ""
                }
              ]
            }
          }
        }
      ]
    }
  ],
